# PostgreSQL (Railway beradi). Bo'sh qolsa SQLite ishlatiladi (local test)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Kamida 32 belgili sir so'z
JWT_SECRET=your-very-secret-key-change-this

# Supabase Storage (rasm saqlash uchun)
# SUPABASE_URL — loyiha URL'i, masalan: https://xxxxxxxx.supabase.co
# SUPABASE_KEY — service_role kalit (Settings → API → service_role)
# "sim-photos" nomli PUBLIC bucket oldindan yaratilgan bo'lishi shart.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
